if TARGET_GX6702

config SYS_BOARD
	default "gx6702"

config SYS_VENDOR
	default "nationalchip"

config SYS_CONFIG_NAME
	default "gx6702"

endif

config VIDEO_GX6702
	bool "NationalChip display output (HDMI and CVBS/YPbPr)"
	depends on VIDEO && (TARGET_GX6702 || TARGET_GX6706)
	select VIDEO_DW_HDMI
	select I2C_EDID
	help
	  Drive the shared GX6702/GX6706 display path. The primary DVE at
	  0xA4804000 feeds HDMI and YPbPr. The secondary VPU/DVE at
	  0xA4900000/0xA4904000 downscales 50 Hz modes to PAL 720x576i CVBS
	  and 60 Hz modes to NTSC 720x480i CVBS. HDMI is the DesignWare TX
	  at 0xA4F00000. The output mode is picked with nationalchip,video-mode.

	  The console framebuffer is RGB and is converted to the UYVY 4:2:2
	  the graphics layer fetches. Those buffers and the vendor-sized
	  812 KiB SVPU working area are reserved from the top of DRAM.
